<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.godikit.exception</groupId>
        <artifactId>godikit-exception-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../godikit-exception/pom.xml</relativePath>
    </parent>

    <artifactId>godikit-exception-parent-jdk17</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>GodiKit Exception Parent (JDK 17)</name>
    <description>Aggregator module for the JDK 17 build of GodiKit Exception, grouping the JDK 17 compatibility
        artifact that verifies the Java 17 bytecode target.
    </description>
    <url>https://www.godikit.com/exception</url>

    <properties>
        <revision>1.0.0</revision>
        <godikit.charset>UTF-8</godikit.charset>
        <godikit.java.version>8</godikit.java.version>

        <java.version>${godikit.java.version}</java.version>
        <maven.compiler.source>${godikit.java.version}</maven.compiler.source>
        <maven.compiler.target>${godikit.java.version}</maven.compiler.target>
        <project.build.sourceEncoding>${godikit.charset}</project.build.sourceEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>

        <!-- central-publishing-maven-plugin -->
        <central-publishing-maven-plugin.version>0.9.0</central-publishing-maven-plugin.version>
        <!-- flatten-maven-plugin -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <!-- jacoco-maven-plugin -->
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <!-- maven-compiler-plugin -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-compiler-plugin.encoding>${godikit.charset}</maven-compiler-plugin.encoding>
        <!-- maven-deploy-plugin.version -->
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <!-- maven-gpg-plugin -->
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <!-- maven-jar-plugin -->
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <!-- maven-javadoc-plugin -->
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-javadoc-plugin.source>${godikit.java.version}</maven-javadoc-plugin.source>
        <maven-javadoc-plugin.encoding>${godikit.charset}</maven-javadoc-plugin.encoding>
        <maven-javadoc-plugin.docencoding>${godikit.charset}</maven-javadoc-plugin.docencoding>
        <maven-javadoc-plugin.charset>${godikit.charset}</maven-javadoc-plugin.charset>
        <!-- maven-resources-plugin -->
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-resources-plugin.encoding>${godikit.charset}</maven-resources-plugin.encoding>
        <!-- maven-source-plugin -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    </properties>

    <modules>
        <module>godikit-exception-jdk17</module>
    </modules>

    <developers>
        <developer>
            <name>Len (田隆)</name>
            <email>len@godikit.com</email>
            <url>https://github.com/lentiancn</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://raw.githubusercontent.com/lentiancn/godikit-exception-java/refs/heads/main/LICENSE</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/lentiancn/godikit-exception-java</url>
        <connection>scm:git:https://github.com/lentiancn/godikit-exception-java.git</connection>
        <developerConnection>scm:git:git@github.com:lentiancn/godikit-exception-java.git</developerConnection>
    </scm>
</project>
