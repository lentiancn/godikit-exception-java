    <artifactId>godikit-exception-parent-jdk17</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>GodiKit Exception Parent (JDK 17)</name>
    <description>Aggregator module for the JDK 17 build of GodiKit Exception, grouping the JDK 17 compatibility
        artifact that verifies the Java 17 bytecode target.
    </description>
    <url>https://www.godikit.com/exception</url>

    <properties>
        <godikit.java.version>17</godikit.java.version>
    </properties>

    <modules>
        <module>godikit-exception-jdk17</module>
    </modules>

    <developers>
